<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_title"
                android:textColor="@color/demo_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="48dp"
                android:text="@string/reset"
                android:textColor="@color/demo_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/demo_subtitle"
                android:textColor="@color/demo_secondary_text"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_snap_enabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/snap" />

            <CheckBox
                android:id="@+id/cb_multiple_choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/multiple_choice" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="@string/demo_instruction"
        android:textColor="@color/demo_secondary_text"
        android:textSize="13sp" />

    <com.jiashuai.touchlayoutapplication.touch.ChartTouchLayout
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1"
        android:background="@drawable/demo_canvas_background">

        <TextView
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="44dp"
            android:background="@drawable/demo_card"
            android:backgroundTint="@color/demo_blue"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/card_a"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginStart="208dp"
            android:layout_marginTop="44dp"
            android:background="@drawable/demo_card"
            android:backgroundTint="@color/demo_green"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/card_b"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginStart="66dp"
            android:layout_marginTop="210dp"
            android:background="@drawable/demo_card"
            android:backgroundTint="@color/demo_orange"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/card_c"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="120dp"
            android:layout_height="72dp"
            android:layout_marginStart="200dp"
            android:layout_marginTop="370dp"
            android:background="@drawable/demo_card"
            android:backgroundTint="@color/demo_pink"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/card_d"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

    </com.jiashuai.touchlayoutapplication.touch.ChartTouchLayout>

</LinearLayout>
